---
/* Rám aplikace: horní lišta (Relume Application Shell 1), obsah pod ní.
   Bez bočního panelu - klient s jedním projektem nemá procházet prázdný
   sloupec. V projektu nese lišta sekce projektu, jinak jen značku a účet.
   Design systém = nový web Webkit.Studio (src/styles/app.css). */
import '../styles/app.css';
import UserMenu from './UserMenu.astro';
import { icon } from '../lib/icons';
import { SECTIONS, type SectionId } from '../lib/portal';

interface Props {
  title: string;
  clientName?: string | null;
  bare?: boolean;
  project?: { slug: string; name: string } | null;
  section?: SectionId | null;
  nav?: 'projects' | 'settings' | null;
  counts?: Partial<Record<SectionId, number>>;
  narrow?: boolean;
}

const { title, bare = false, project = null, section = null, nav = null, counts = {}, narrow = false } = Astro.props;
const user = Astro.locals.user;
/* Odkaz „Projekty" má smysl jen tomu, kdo jich má víc. */
const viceProjektu = !!user && (user.role === 'admin' || user.projects.length > 1);
const aktivniNav = nav ?? (Astro.url.pathname.includes('/settings') ? 'settings' : project ? null : 'projects');
const demo = Astro.url.searchParams.get('demo') === '1' ? '?demo=1' : '';
const sekce = project
  ? SECTIONS.map((s) => ({ ...s, href: `/client/${project.slug}${s.slug ? '/' + s.slug : ''}${demo}`, on: section === s.id }))
  : [];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ECEFF3" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/client/assets/favicon.svg" />
    <link rel="icon" type="image/png" href="/client/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/client/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-me={user ? user.id : undefined}>
    <div class="mist" aria-hidden="true"><i class="a"></i><i class="b"></i></div>

    {bare ? (
      <main><slot /></main>
    ) : (
      <div class="app">
        <header class="tb" id="tb">
          <div class="in">
            <a class="brand" href={viceProjektu ? '/client/dashboard' : project ? `/client/${project.slug}` : '/client/dashboard'}>
              <img src="/client/assets/symbol-blue.png" alt="" />Webkit.Studio
            </a>

            {project && (
              <div class="crumb" aria-hidden="true">
                <span class="sep">/</span>
                <b>{project.name}</b>
              </div>
            )}

            {project ? (
              <nav class="links" aria-label="Sekce projektu">
                {sekce.map((s) => (
                  <a href={s.href} aria-current={s.on ? 'page' : undefined}>
                    {s.label}{counts[s.id] ? <span class="n">{counts[s.id]}</span> : null}
                  </a>
                ))}
              </nav>
            ) : viceProjektu ? (
              <nav class="links" aria-label="Hlavní">
                <a href="/client/dashboard" aria-current={aktivniNav === 'projects' ? 'page' : undefined}>Projekty</a>
              </nav>
            ) : null}

            <div class:list={['right', { push: !project && !viceProjektu }]}>
              {viceProjektu && project && <a class="btn light sm" href="/client/dashboard"><Fragment set:html={icon('grid')} />Projekty</a>}
              {user && <UserMenu />}
              <button type="button" class="burger" aria-label="Menu" aria-controls="mnav" aria-expanded="false" data-nav-toggle>
                <Fragment set:html={icon('menu')} />
              </button>
            </div>
          </div>

          <div class="mnav" id="mnav">
            <div>
              {project && (
                <div class="grp">
                  {sekce.map((s) => (
                    <a href={s.href} aria-current={s.on ? 'page' : undefined}><Fragment set:html={icon(s.icon)} />{s.label}</a>
                  ))}
                </div>
              )}
              <div class="grp">
                {viceProjektu && <a href="/client/dashboard" aria-current={aktivniNav === 'projects' ? 'page' : undefined}><Fragment set:html={icon('grid')} />Projekty</a>}
                <a href="/client/settings/account" aria-current={aktivniNav === 'settings' ? 'page' : undefined}><Fragment set:html={icon('settings')} />Nastavení</a>
              </div>
            </div>
          </div>
        </header>

        <main class="main"><div class:list={['page', { narrow }]}><slot /></div></main>
      </div>
    )}

    <script>
      const btn = document.querySelector('[data-nav-toggle]');
      btn?.addEventListener('click', () => {
        const open = !document.body.classList.contains('nav-open');
        document.body.classList.toggle('nav-open', open);
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { document.body.classList.remove('nav-open'); btn?.setAttribute('aria-expanded', 'false'); } });
      const tb = document.getElementById('tb');
      const s = () => tb?.classList.toggle('s', scrollY > 6);
      addEventListener('scroll', s, { passive: true }); s();
    </script>
  </body>
</html>
