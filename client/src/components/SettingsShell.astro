---
/* Rám nastavení: hlavička a taby, pod nimi obsah. Klient má jen Můj účet,
   admin i obě správy - skrytí tabů není bezpečnostní prvek, adresy hlídá
   middleware. nav[aria-label="Nastavení"] a #stav drží testy. */
import Layout from './Layout.astro';

interface Props {
  title: string;
  tab: 'account' | 'projects' | 'users';
}
const { title, tab } = Astro.props;
const user = Astro.locals.user!;

const taby = [
  { id: 'account', href: '/client/settings/account', label: 'Můj účet', admin: false },
  { id: 'projects', href: '/client/settings/projects', label: 'Správa projektů', admin: true },
  { id: 'users', href: '/client/settings/users', label: 'Správa uživatelů', admin: true }
].filter((t) => !t.admin || user.role === 'admin');
---

<Layout title={`${title} – Webkit.Studio`} nav="settings">
  <div class="ph rv">
    <div><h1>Nastavení</h1></div>
    <nav class="tabs" aria-label="Nastavení">
      {taby.map((t) => (
        <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>{t.label}</a>
      ))}
    </nav>
  </div>

  <p id="stav" class="note" role="status" aria-live="polite" hidden></p>
  <div class="rv d1"><slot /></div>
</Layout>

<script>
  /* Hlášky na jednom místě pro všechny taby nastavení. */
  const box = document.getElementById('stav');
  (window as any).stav = (text: string, chyba = false) => {
    if (!box) return;
    box.textContent = text;
    box.hidden = false;
    box.classList.toggle('err', chyba);
    box.classList.toggle('ok', !chyba);
    box.style.marginBottom = '18px';
  };
</script>
