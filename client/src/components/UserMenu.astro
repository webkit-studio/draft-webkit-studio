---
/* Účet v patě bočního panelu: avatar, jméno, e-mail a nabídka, která se
   otevírá nahoru. Selektory data-usermenu-* drží testy - neměnit. */
import { displayName, initial } from '../lib/db';
import { icon } from '../lib/icons';

const user = Astro.locals.user!;
const jmeno = displayName(user);
const pismeno = initial(user);
---

<div class="um" data-usermenu>
  <button type="button" class="um-t" aria-haspopup="menu" aria-expanded="false" data-usermenu-trigger>
    <span class="avatar blue" aria-hidden="true">{pismeno}</span>
    <span class="um-n">
      <span class="um-name">{jmeno}</span>
      <span class="um-mail">{user.email}</span>
    </span>
    <span class="um-c" aria-hidden="true" data-usermenu-caret set:html={icon('chevron')} />
  </button>

  <div class="um-p" role="menu" data-usermenu-panel hidden>
    <a href="/client/settings/account" role="menuitem">
      <Fragment set:html={icon('settings')} /> Nastavení
    </a>
    <form method="post" action="/client/api/logout">
      <button type="submit" role="menuitem"><Fragment set:html={icon('logout')} /> Odhlásit</button>
    </form>
  </div>
</div>

<style>
  .um { position: relative; }
  .um-t { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; border: 1px solid var(--hair);
    border-radius: 16px; background: #fff; text-align: left; box-shadow: var(--sh-card); transition: box-shadow .3s var(--ease), transform .3s var(--ease); }
  .um-t:hover { box-shadow: var(--sh-hover); }
  .um-n { min-width: 0; flex: 1; display: flex; flex-direction: column; }
  .um-name { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .um-mail { font-size: 12px; color: var(--mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .um-c { color: var(--mute); transform: rotate(180deg); transition: transform .25s var(--ease); }
  .um-c :global(svg) { width: 16px; height: 16px; }
  .um-t[aria-expanded="true"] .um-c { transform: rotate(0); }
  .um-p { position: absolute; left: 0; right: 0; bottom: calc(100% + 8px); z-index: 50; padding: 6px; border-radius: 16px;
    background: #fff; border: 1px solid var(--hair); box-shadow: var(--sh-hover); }
  .um-p a, .um-p button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px; border: 0; background: none;
    border-radius: 10px; font-size: 14px; font-weight: 500; color: var(--ink2); text-align: left; transition: background .2s; }
  .um-p a:hover, .um-p button:hover { background: var(--card2); color: var(--ink); }
  .um-p :global(svg) { width: 17px; height: 17px; }
  .um-p form { margin: 0; }
</style>

<script>
  const wrap = document.querySelector('[data-usermenu]');
  if (wrap) {
    const trigger = wrap.querySelector('[data-usermenu-trigger]') as HTMLButtonElement;
    const panel = wrap.querySelector('[data-usermenu-panel]') as HTMLElement;
    const zavri = () => { panel.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
    const otevri = () => { panel.hidden = false; trigger.setAttribute('aria-expanded', 'true'); };
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      trigger.getAttribute('aria-expanded') === 'true' ? zavri() : otevri();
    });
    document.addEventListener('click', (e) => { if (!wrap.contains(e.target as Node)) zavri(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') { zavri(); trigger.focus(); }
    });
  }
</script>
