---
/* Můj účet. Jediný tab, který vidí i klient.
 *
 * Heslo: uložené heslo přečíst nelze, je to jednosměrný hash - ani admin ho
 * nezobrazí. Kdo svoje heslo zná, přepíše si ho tady; kdo ho zapomněl, dostane
 * od admina vygenerované nové. Třetí cesta neexistuje a je to tak správně. */
import SettingsShell from '../../components/SettingsShell.astro';
import { initial, fullName } from '../../lib/db';

export const prerender = false;

const user = Astro.locals.user!;
const pismeno = initial(user);
const jmeno = fullName(user);
---

<SettingsShell title="Můj účet" tab="account">
  <section class="card">
    <header class="acc-head">
      <span class="avatar lg blue" aria-hidden="true">{pismeno}</span>
      <div class="min-w-0">
        <div class="acc-name">{jmeno}</div>
        <div class="acc-mail">{user.email}</div>
      </div>
      <span class:list={['chip', user.role === 'admin' ? 'ink' : '']}>{user.role === 'admin' ? 'Administrátor' : 'Klient'}</span>
    </header>

    <form id="f-jmeno" class="acc-form">
      <h3>Jméno</h3>
      <div class="acc-row">
        <label class="field"><span>Jméno</span><input class="input" name="firstName" type="text" value={user.firstName || ''} /></label>
        <label class="field"><span>Příjmení</span><input class="input" name="lastName" type="text" value={user.lastName || ''} /></label>
      </div>
      <button type="submit" class="btn sm">Uložit jméno</button>
    </form>
  </section>

  <section class="card acc-pw">
    <form id="f-heslo" class="acc-form">
      <h3>Heslo</h3>
      <p class="acc-hint">Uložené heslo nejde zobrazit – v databázi je jen jeho otisk. Zapomenuté heslo nahradí admin novým.</p>
      <div class="acc-row">
        <label class="field"><span>Současné heslo</span><input class="input" name="current" type="password" autocomplete="current-password" required /></label>
        <label class="field"><span>Nové heslo (min. 12 znaků)</span><input class="input" name="next" type="password" autocomplete="new-password" minlength="12" required /></label>
      </div>
      <button type="submit" class="btn sm">Změnit heslo</button>
    </form>
  </section>

  <style>
    .acc-head { display: flex; align-items: center; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--hair); }
    .acc-head .chip { margin-left: auto; }
    .acc-name { font-weight: 600; font-size: 16px; }
    .acc-mail { color: var(--mute); font-size: 13.5px; }
    .acc-form { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
    .acc-form h3 { font-size: 19px; }
    .acc-hint { color: var(--mute); font-size: 14px; max-width: 60ch; margin-top: -6px; }
    .acc-row { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; width: 100%; }
    .acc-pw { margin-top: 18px; }
    @media (max-width: 640px) { .acc-row { grid-template-columns: 1fr; } }
  </style>
</SettingsShell>

<script>
  const stav = (t: string, e = false) => (window as any).stav(t, e);

  const CHYBY: Record<string, string> = {
    'wrong-password': 'Současné heslo nesouhlasí.',
    'password-too-short': 'Nové heslo musí mít aspoň 12 znaků.',
    'name-too-long': 'Jméno je moc dlouhé.',
    'no-db': 'Databáze není připojená.',
    'unauthorized': 'Session vypršela, přihlas se znovu.'
  };

  async function posli(body: unknown) {
    const res = await fetch('/client/api/account', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(CHYBY[data.error] || `Nepovedlo se (${data.error || res.status}).`);
    return data;
  }

  document.getElementById('f-jmeno')!.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(ev.target as HTMLFormElement);
    try {
      await posli({ akce: 'jmeno', firstName: fd.get('firstName'), lastName: fd.get('lastName') });
      stav('Jméno uloženo.');
      /* jméno je i v hlavičce - ať sedí bez ručního obnovení */
      setTimeout(() => location.reload(), 600);
    } catch (e: any) {
      stav(e.message, true);
    }
  });

  document.getElementById('f-heslo')!.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const form = ev.target as HTMLFormElement;
    const fd = new FormData(form);
    try {
      await posli({ akce: 'heslo', current: fd.get('current'), next: fd.get('next') });
      form.reset();
      stav('Heslo změněno. Ostatní přihlášení tohoto účtu byla ukončena.');
    } catch (e: any) {
      stav(e.message, true);
    }
  });
</script>
