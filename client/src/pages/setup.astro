---
/* Jednorázové založení databáze - formulářem, ne adresou.
 *
 * Token v adrese je past: Base64 secret obsahuje "+", které se v dotazu
 * adresy čte jako mezera, a "/" nebo "=" svádí k překlepu. Pole ve
 * formuláři posílá hodnotu tak, jak je. */
import Layout from '../components/Layout.astro';
import { getEnv, getDb } from '../lib/env';

export const prerender = false;

const env = getEnv();
const db = getDb();

/* Je už hotovo? Pak se sem nemá co ukazovat. */
let hotovo = false;
if (db) {
  try {
    const t = await db.prepare(`SELECT name FROM sqlite_master WHERE type='table' AND name='users'`).first();
    if (t) hotovo = !!(await db.prepare(`SELECT 1 AS x FROM users LIMIT 1`).first());
  } catch {
    hotovo = false;
  }
}

const dbReady = !!db;
const secretReady = !!env.SESSION_SECRET;
---

<Layout title="Založení databáze – Webkit.Studio" bare={true}>
  <div class="su">
    <div class="su-box">
      <div class="su-brand"><img src="/client/assets/symbol-blue.png" alt="" />Webkit.Studio</div>
      <h1>Založení databáze</h1>

      {!dbReady && (
        <p class="note">Databáze není připojená.</p>
      )}

      {dbReady && !secretReady && (
        <p class="note">
          Není nastavená proměnná SESSION_SECRET.
        </p>
      )}

      {dbReady && secretReady && hotovo && (
        <p class="note">
          Databáze už je založená. Tahle stránka je tím uzavřená.
          <a class="su-link" href="/client/login">Přihlásit se</a>
        </p>
      )}

      {dbReady && secretReady && !hotovo && (
        <>
          <p class="muted">
            Vlož SESSION_SECRET z Environment variables. Proběhne to jednou – vytvoří se
            schéma, projekty a dva účty. Hesla se ukážou jen teď.
          </p>
          <form id="f" class="flex flex-col gap-2">
            <input
              id="token"
              class="input"
              type="password"
              placeholder="SESSION_SECRET"
              autocomplete="off"
              required
              aria-label="SESSION_SECRET"
            />
            <button
              type="submit"
              class="btn full"
            >
              Založit
            </button>
          </form>
          <pre id="out" class="su-out" hidden></pre>
        </>
      )}
    </div>
  </div>
</Layout>

<style>
  .su { display: grid; place-items: center; min-height: 100svh; padding: 24px; }
  .su-box { width: 100%; max-width: 460px; display: flex; flex-direction: column; gap: 14px; }
  .su-brand { display: flex; align-items: center; gap: 9px; color: var(--blue); font-family: var(--display); font-variation-settings: "opsz" 24, "wght" 600; font-size: 16px; margin-bottom: 12px; }
  .su-brand img { width: 24px; height: 24px; }
  .su-box h1 { font-size: 32px; font-variation-settings: "opsz" 96, "wght" 400; }
  .su-box form { display: flex; flex-direction: column; gap: 10px; }
  .su-out { margin: 0; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--hair); background: #fff; font-family: var(--mono); font-size: 13px; overflow-x: auto; white-space: pre-wrap; }
  .su-link { margin-left: 8px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  const f = document.getElementById('f');

  /* Kroky se poustej jeden po druhem. Kazdy je samostatny pozadavek, takze
     kdyz nektery selze, vidime PRESNE ktery a proc - misto jedine hlasky
     "nepodarilo se spojit se serverem". */
  const KROKY = [
    ['schema', 'Zakládám tabulky'],
    ['projekty', 'Vkládám projekty'],
    ['admin', 'Zakládám účet lukas@webkit.studio'],
    ['klient', 'Zakládám účet test@webkit.studio']
  ];

  if (f) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const out = document.getElementById('out');
      const btn = f.querySelector('button');
      const token = (document.getElementById('token')).value;
      const radky = [];
      const hesla = [];

      out.hidden = false;
      out.style.borderColor = '';
      btn.disabled = true;
      const vypis = () => { out.textContent = radky.join('\n'); };

      for (const [krok, popis] of KROKY) {
        radky.push(`${popis}…`);
        vypis();
        let d = null;
        try {
          const res = await fetch(`/client/api/setup?krok=${krok}`, {
            headers: { 'X-Setup-Token': token }
          });
          d = await res.json().catch(() => null);
          if (!res.ok) {
            radky[radky.length - 1] =
              `${popis}: CHYBA (${res.status}) ${d ? d.error || '' : ''} ${d && d.detail ? '– ' + d.detail : ''}`;
            out.style.borderColor = '#E5484D';
            vypis();
            btn.disabled = false;
            return;
          }
        } catch (err) {
          /* Spojeni umrelo uprostred kroku - rekneme aspon u ktereho. */
          radky[radky.length - 1] = `${popis}: spojení se serverem se přerušilo.`;
          radky.push('Zkus to znovu – kroky jdou opakovat, nic se nerozbije.');
          out.style.borderColor = '#E5484D';
          vypis();
          btn.disabled = false;
          return;
        }

        const detaily = [];
        if (d.preskoceno) detaily.push('už existovalo');
        if (d.projektu !== undefined) detaily.push(`${d.projektu} projektů`);
        if (d.vytvoreno) detaily.push(`${d.vytvoreno.length} tabulek`);
        if (d.trvalo_ms !== undefined) detaily.push(`${d.trvalo_ms} ms`);
        radky[radky.length - 1] = `${popis}: hotovo${detaily.length ? ' (' + detaily.join(', ') + ')' : ''}`;
        if (d.heslo) hesla.push(`${d.email}\n${d.role}\n${d.heslo}`);
        vypis();
      }

      radky.push('');
      if (hesla.length) {
        radky.push('HESLA – ulož si je, už se neukážou:');
        radky.push('');
        radky.push(hesla.join('\n\n'));
      } else {
        radky.push('Účty už existovaly, hesla se proto neukazují.');
        radky.push('Nové heslo si vygeneruješ ve Správě po přihlášení.');
      }
      radky.push('');
      radky.push('Hotovo. Přihlas se na /client/login');
      vypis();
      btn.disabled = false;
    });
  }
</script>
